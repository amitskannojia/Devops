provider "aws" {
region  = "eu-north-1"

}

resource "aws_security_group" "my_sg" {
  name = "web-sg"

  ingress {
    to_port = 80
    from_port = 80
    protocol =  "tcp" 
    cidr_blocks =  ["0.0.0.0/0"]
  }

  ingress {
    to_port = 22
    from_port = 22
    protocol =  "tcp"
    cidr_blocks =  ["0.0.0.0/0"]
  
  }

  egress {
    to_port = 0
    from_port = 0
    protocol = "-1"
    cidr_blocks =  ["0.0.0.0/0"] 
  
  }

  tags =  {
    Name =  "my-sg"
  
  }

}

resource  "aws_instance"  "web1"  {

  ami = "ami-0fa91bc90632c73c9"
  instance_type = "t3.micro"

  vpc_security_group_ids = [aws_security_group.my_sg.id]

  user_data = <<-EOF
    #!/bin/bash
    apt update -y
    apt install nginx -y

    systemctl start nginx
    systemctl enable nginx
  EOF

  tags =  {
    Name = "Web-server"
  
  }

}

output "public_ip"  {
  value = aws_instance.web1.public_ip
}
