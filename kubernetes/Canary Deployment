#Canary 1
apiVersion: apps/v1
kind: Deployment

metadata:
  name: canary-v1

spec:
  replicas: 4

  selector:
    matchLabels:
      app: canary-nginx
      version:v1

  template:
    metadata:
      labels:
        app: canary-nginx
        version: v1

    spec:
      containers:
      - name: nginx
        image: nginx:1.25
      	ports:
	- containerPort: 80

---

#Canary 2 (New Version)
apiVersion: apps/v1
kind: Deployment

metadata:
  name: canary-v2

spec:
  replicas: 1

  selector:
    matchLabels:
      app: nginx
      version: v2

  template:
    metadata:
      labels:
        app: canary-nginx
        version: v2

    spec:
      containers:
      - name: nginx
        image: nginx:1.27
        ports:
	- containerPort: 80

---
