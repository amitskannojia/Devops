#NodePort
apiVersion: v1
kind: Pod

metadata:
  name: nodeport-pod
  labels:
    app: nodeport-app

specs:
  containers:
   -name: con1
    image: ishika979/super-mario
    ports:
    - containerPort: 80

---

apiVersion: v1
kind: Service

metadata:
  name: nodeport-svc

  specs:
    selector:
      app: nodeport-app

    type: NodePort

    ports:
    - port: 80
      targetPort: 80
      nodePort: 30080
---
