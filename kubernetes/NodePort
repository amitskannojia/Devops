#NodePort
apiVersion: v1
kind: Pod
metadata:
  name: my-pod
  labels:
    app: my-app
specs:
  containers:
   -name: con1
    image: ishika979/super-mario
    ports:
    -containerPort: 80

---

apiVersion: v1
kind: Service
metadata:
  name: my-svc
  specs:
    selector:
      app: my-app
    type: NodePort
  ports:
    -port: 80
     targetPort: 80
     nodePort: 30080
---
