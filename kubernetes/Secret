#Secret
apiVersion: v1
kind: Secret

metadata:
  name: db-secret

type: Opaque

stringData:
  DB_USERNAME: admin
  DB_PASSWORD: MyPassword123

---

#Secret Pod
apiVersion: v1
kind: Pod

metadata:
  name: secret-pod

spec:
  containers:
  - name: nginx
    image: nginx:latest

    env:
    - name: DB_USERNAME
      valueFrom:
       secretKeyRef:
        name: db-secret
        key: DB_USERNAME

  - name: DB_PASSWORD
    valueFrom:
      secretKeyRef:
        name: db-secret
        key: DB_PASSWORD
