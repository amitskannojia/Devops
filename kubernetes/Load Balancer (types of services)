#LoadBalancer
apiVersion: v1
kind: Pod
metadata:
  name: my-pod
  labels:
    app: nginx
specs:
  -containers:
    name: con1
    image: nginx
    ports:
    -containerPort: 80

---

apiVersion: v1
kind: Service
metadata:
  name: nginx-loadbalancer
  specs:
    selector:
      app: nginx
    type: LoadBalancer
  ports:
    -port: 80
     targetPort: 80
