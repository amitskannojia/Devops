#LoadBalancer
apiVersion: v1
kind: Pod

metadata:
  name: loadbalancer-pod
  labels:
    app: loadbalancer-app

specs:
  -containers:
    name: con1
    image: nginx
    ports:
    - containerPort: 80

---

apiVersion: v1
kind: Service

metadata:
  name: nginx-loadbalancer

  specs:
    selector:
      app: loadbalancer-app

    type: LoadBalancer

    ports:
    - port: 80
      targetPort: 80

---
