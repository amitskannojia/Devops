#Stateless
apiversion: apps/v1
kind: Deployment
metadata:
  name: stateless-deployment
spec:
  replicas: 3
  selector:
    matchLabels:
      app: nginx
  template:
    metadata:
      labels:
        app: nginx
spec:
  containers:
   - name: stateless
     image: nginx
  ports:
    - containerPort: 80
