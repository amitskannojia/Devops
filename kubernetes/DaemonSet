#DaemonSet
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: my-ds
  labels:
    app: nginx
spec:
  selector:
    matchLabels:
      app: nginx
  template:
    metadata:
      labels:
        app: nginx
  spec:
    containers:
      - name: con3
        image: nginx
    ports:
    - containerPort: 80  
