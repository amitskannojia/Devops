#Namespace-pod-file
apiVersion: app/v1
kind: Deployment

metadata:
  name: ns-pod
  namespace: production

spec:
  replicas: 2

  selector:
    matchLabels:
      app: nginx
  
    template:
      metadata:
        labels:
          app: nginx

  spec:
    containers:
    - name: nginx
      image: nginx:latest
      ports:
      - containerPort: 80

---

apiVersion: v1
kind: Service

metadata:
  name: my-svc
  namespace: production

spec:
  selector:
    app: namespace-nginx

  ports:
  - port: 80
    targetPort: 80

---
