#HPA Deployment 
apiVersion: apps/v1
kind: Deployment

metadata:
  name: hpa-nginx

spec:
  replicas: 2

  selector:
    matchLabels:
      app: hpa-nginx

  template:
    metadata:
      labels:
        app: hpa-nginx

  spec:
    containers:
    - name: hpa-nginx
      image: nginx:latest

      resources:
        requests:
          cpu: 100m
          memory: 128Mi

        limits:
          cpu: 500m
          memory: 256Mi
  
      ports:
      - containerPort: 80

---

#HPA Service
apiVersion: v1
kind: Service

metadata:
  name: hpa-service

spec:
  type: ClusterIP

  selector:
    app: hpa-nginx

  ports:
  - port: 80
    tagetPort: 80

---
